      "facility_type": {"type": "keyword"},
      "granularity": {"type": "keyword"},
      "status": {"type": "keyword"},
      "production_start": {"type": "keyword"},
      "products": {"type": "keyword", "copy_to": "search_text"},
      "processes": {"type": "keyword", "copy_to": "search_text"},
      "notes": {"type": "text", "copy_to": "search_text"},
      "sources": {
